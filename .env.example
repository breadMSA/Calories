# Gemini API (原本的官方 API key - 現在改用 Reverse API 可不填)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Reverse API Cookies (必填 - 從 gemini.google.com 取得)
# 取得方式: 登入 gemini.google.com → F12 → Network → 複製 Cookie
GEMINI_1PSID=your_secure_1psid_cookie_value
GEMINI_1PSIDTS=your_secure_1psidts_cookie_value

# Vercel KV (automatically injected by Vercel when you connect a KV database)
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
