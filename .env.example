# Postgres connection string. Added automatically when you connect a Neon database
# through Vercel > Storage. Leave empty locally to use the embedded dev database (.data/).
DATABASE_URL=

# Google AI Studio key for photo / text analysis: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: comma-separated models, tried in order; the next one is used when a model's
# free quota runs out. Default: gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.8-flash,gemini-2.5-flash-lite
# GEMINI_MODELS=

# Required to sign up. Share it only with the people who should have access.
# If unset, only the very first account can be created.
INVITE_CODE=

# Optional: AI analyses allowed per user per day (default 40)
# AI_DAILY_LIMIT=40
